rch.as_tensor(d[pred_key]).cpu().long()\n        assert len(preds) == len(y), (\n            f\"{condition_name}: {model_name} prediction/label length mismatch\"\n        )\n        correct[model_name] = preds.eq(y)\n        fixed_rows.append({\n            \"Condition\": condition_name,\n            \"Model\": model_name,\n            \"Accuracy (%)\": 100 * correct[model_name].float().mean().item(),\n            \"Expected model-only latency (ms/image)\": MODEL_LATENCY_MS[model_name],\n        })\n\n    # Oracle upper bound: correct if at least one candidate model is correct.\n    any_correct = torch.stack(list(correct.values())).any(dim=0)\n    oracle_rows.append({\n        \"Condition\": condition_name,\n        \"Oracle accuracy upper bound (%)\":\n            100 * any_correct.float().mean().item(),\n        \"Images wrong for all three\": int((~any_correct).sum().item()),\n    })\n\n    # Randomized, input-independent mixtures:\n    # choose one fixed model at random, with probabilities independent of image.\n    # For each latency budget, enumerate all model pairs; an optimal mixture\n    # under one expected-latency constraint needs at most two nonzero weights.\n    names = list(MODEL_KEYS)\n    acc = {\n        name: correct[name].float().mean().item()\n        for name in names\n    }\n    budgets = sorted(set(MODEL_LATENCY_MS.values()))\n\n    for budget in budgets:\n        best = None\n\n        # Pure-model choices.\n        for name in names:\n            latency = MODEL_LATENCY_MS[name]\n            if latency <= budget + 1e-9:\n                candidate = {\n                    \"accuracy\": acc[name],\n                    \"latency\": latency,\n                    \"mixture\": f\"100% {name}\",\n                }\n                if best is None or candidate[\"accuracy\"] > best[\"accuracy\"]:\n                    best = candidate\n\n        # Two-model randomized mixtures, constrained by expected latency.\n        for name_a, name_b in itertools.combinations(names, 2):\n            lat_a, lat_b = MODEL_LATENCY_MS[name_a], MODEL_LATENCY_MS[name_b]\n            acc_a, acc_b = acc[name_a], acc[name_b]\n\n            # p is the probability of choosing model A; solve the latency\n            # budget boundary, then check both endpoints and boundary.\n            candidates_p = [0.0, 1.0]\n            if abs(lat_a - lat_b) > 1e-12:\n                p_boundary = (budget - lat_b) / (lat_a - lat_b)\n                if 0.0 <= p_boundary <= 1.0:\n                    candidates_p.append(p_boundary)\n\n            for p in candidates_p:\n                latency = p * lat_a + (1 - p) * lat_b\n                if latency <= budget + 1e-9:\n                    mix_acc = p * acc_a + (1 - p) * acc_b\n                    candidate = {\n                        \"accuracy\": mix_acc,\n                        \"latency\": latency,\n                        \"mixture\": (\n                            f\"{100*p:.1f}% {name_a} + \"\n                            f\"{100*(1-p):.1f}% {name_b}\"\n                        ),\n                    }\n                    if best is None or candidate[\"accuracy\"] > best[\"accuracy\"]:\n                        best = candidate\n\n        assert best is not None, f\"No feasible mixture for budget {budget}\"\n        mixture_rows.append({\n            \"Condition\": condition_name,\n            \"Latency budget (ms/image)\": budget,\n            \"Best random-mixture accuracy (%)\": 100 * best[\"accuracy\"],\n            \"Mixture expected latency (ms/image)\": best[\"latency\"],\n            \"Mixture\": best[\"mixture\"],\n        })\n\nfixed_df = pd.DataFrame(fixed_rows)\nmixture_df = pd.DataFrame(mixture_rows)\noracle_df = pd.DataFrame(oracle_rows)\n\nprint(\"Fixed-model accuracies and expected model-only latencies\")\ndisplay(fixed_df.pivot(\n    index=\"Condition\",\n    columns=\"Model\",\n    values=\"Accuracy (%)\"\n).round(2))\ndisplay(fixed_df.drop_duplicates(\n    subset=[\"Model\", \