es)\n    values = torch.quantile(scores, q).unique().tolist()\n    # Explicitly include no-escalation and all-escalation choices.\n    return sorted(set([0.0, *values, 1.000001]))\n\ndef candidates_for(route, tuning_data):\n    if route == \"R->V\":\n        return [(tr, None) for tr in threshold_grid(tuning_data[\"rc\"][tune_idx], 41)]\n    if route == \"M->V\":\n        return [(None, tm) for tm in threshold_grid(tuning_data[\"mc\"][tune_idx], 41)]\n\n    r_grid = threshold_grid(tuning_data[\"rc\"][tune_idx], 21)\n    m_grid = threshold_grid(tuning_data[\"mc\"][tune_idx], 21)\n    return list(itertools.product(r_grid, m_grid))\n\ndef choose_thresholds(route, tuning_data, budget):\n    y_tune = tuning_data[\"y\"][tune_idx]\n    best = None\n\n    for tr, tm in candidates_for(route, tuning_data):\n        pred, cost = route_output(tuning_data, route, tr=tr, tm=tm)\n        mean_cost = cost[tune_idx].mean().item()\n\n        if mean_cost <= budget + 1e-9:\n            acc = pred[tune_idx].eq(y_tune).float().mean().item()\n            candidate = (acc, mean_cost, tr, tm)\n\n            if (\n                best is None\n                or candidate[0] > best[0]\n                or (candidate[0] == best[0] and candidate[1] < best[1])\n            ):\n                best = candidate\n\n    return best\n\ndef best_random_mixture_accuracy(d, latency_budget):\n    y = d[\"y\"][eval_idx]\n    model_preds = {\n        \"ResNet-20\": d[\"r\"][eval_idx],\n        \"MobileNetV2 ×1.4\": d[\"m\"][eval_idx],\n        \"ViT-Base/16\": d[\"v\"][eval_idx],\n    }\n    names = list(model_preds)\n    acc = {\n        name: model_preds[name].eq(y).float().mean().item()\n        for name in names\n    }\n    costs = {\n        \"ResNet-20\": LATENCY[\"R\"],\n        \"MobileNetV2 ×1.4\": LATENCY[\"M\"],\n        \"ViT-Base/16\": LATENCY[\"V\"],\n    }\n\n    best = max(\n        (acc[name] for name in names if costs[name] <= latency_budget + 1e-9),\n        default=None,\n    )\n\n    for name_a, name_b in itertools.combinations(names, 2):\n        lat_a, lat_b = costs[name_a], costs[name_b]\n        acc_a, acc_b = acc[name_a], acc[name_b]\n        probabilities_a = [0.0, 1.0]\n\n        if abs(lat_a - lat_b) > 1e-12:\n            p = (latency_budget - lat_b) / (lat_a - lat_b)\n            if 0.0 <= p <= 1.0:\n                probabilities_a.append(p)\n\n        for p in probabilities_a:\n            expected_latency = p * lat_a + (1 - p) * lat_b\n            if expected_latency <= latency_budget + 1e-9:\n                mixed_accuracy = p * acc_a + (1 - p) * acc_b\n                best = mixed_accuracy if best is None else max(best, mixed_accuracy)\n\n    return best\n\nrows = []\nroutes = [\"R->V\", \"M->V\", \"R->M->V\"]\n\nfor condition_name, eval_data in data.items():\n    for threshold_source in [\"clean\", condition_name]:\n        tuning_data = data[threshold_source]\n\n        for route in routes:\n            for budget in BUDGETS:\n                selected = choose_thresholds(route, tuning_data, budget)\n                if selected is None:\n                    continue\n\n                tune_acc, tune_cost, tr, tm = selected\n                eval_pred, eval_cost = route_output(\n                    eval_data, route, tr=tr, tm=tm\n                )\n                y_eval = eval_data[\"y\"][eval_idx]\n                eval_acc = eval_pred[eval_idx].eq(y_eval).float().mean().item()\n                eval_latency = eval_cost[eval_idx].mean().item()\n                mixture_acc = best_random_mixture_accuracy(\n                    eval_data, eval_latency\n                )\n\n                rows.append({\n                    \"Condition\": condition_name,\n                    \"Threshold source\": (\n                        \"clean-tuned\" if threshold_source == \"clean\"\n                        else \"condition-tuned upper bound\"\n                    ),\n                    \"Route\": route,\n                    \"Tuning latency budget 