f route == \"R->V\":\n        escalate = d[\"rc\"] < tr\n        return torch.where(escalate, v, r), LATENCY[\"R\"] + escalate.float() * LATENCY[\"V\"]\n\n    if route == \"M->V\":\n        escalate = d[\"mc\"] < tm\n        return torch.where(escalate, v, m), LATENCY[\"M\"] + escalate.float() * LATENCY[\"V\"]\n\n    if route == \"R->M->V\":\n        to_m = d[\"rc\"] < tr\n        to_v = to_m & (d[\"mc\"] < tm)\n        pred = torch.where(to_v, v, torch.where(to_m, m, r))\n        cost = LATENCY[\"R\"] + to_m.float() * LATENCY[\"M\"] + to_v.float() * LATENCY[\"V\"]\n        return pred, cost\n\n    raise ValueError(route)\n\ndef threshold_grid_fixed(scores, n_quantiles):\n    q = torch.linspace(0, 1, n_quantiles)\n    values = torch.quantile(scores, q).unique().tolist()\n    return sorted(set([0.0, *values, 1.000001]))\n\ndef candidate_thresholds(route, tuning_data):\n    if route == \"R->V\":\n        return [(tr, None) for tr in threshold_grid_fixed(tuning_data[\"rc\"][tune_idx], 41)]\n    if route == \"M->V\":\n        return [(None, tm) for tm in threshold_grid_fixed(tuning_data[\"mc\"][tune_idx], 41)]\n\n    r_grid = threshold_grid_fixed(tuning_data[\"rc\"][tune_idx], 21)\n    m_grid = threshold_grid_fixed(tuning_data[\"mc\"][tune_idx], 21)\n    return list(itertools.product(r_grid, m_grid))\n\ndef choose_thresholds_fixed(route, tuning_data, budget):\n    y_tune = tuning_data[\"y\"][tune_idx]\n    best = None\n\n    for tr, tm in candidate_thresholds(route, tuning_data):\n        pred, cost = route_output_fixed(tuning_data, route, tr=tr, tm=tm)\n        mean_cost = cost[tune_idx].mean().item()\n\n        if mean_cost <= budget + EPS:\n            acc = pred[tune_idx].eq(y_tune).float().mean().item()\n            candidate = (acc, mean_cost, tr, tm)\n            if (\n                best is None\n                or candidate[0] > best[0]\n                or (candidate[0] == best[0] and candidate[1] < best[1])\n            ):\n                best = candidate\n\n    return best\n\ndef mixture_accuracy_fixed(d, latency_budget):\n    y = d[\"y\"][eval_idx]\n    preds = {\n        \"ResNet-20\": d[\"r\"][eval_idx],\n        \"MobileNetV2 ×1.4\": d[\"m\"][eval_idx],\n        \"ViT-Base/16\": d[\"v\"][eval_idx],\n    }\n    costs = {\n        \"ResNet-20\": LATENCY[\"R\"],\n        \"MobileNetV2 ×1.4\": LATENCY[\"M\"],\n        \"ViT-Base/16\": LATENCY[\"V\"],\n    }\n    acc = {name: pred.eq(y).float().mean().item() for name, pred in preds.items()}\n    names = list(preds)\n\n    feasible = [acc[name] for name in names if costs[name] <= latency_budget + EPS]\n    best = max(feasible) if feasible else None\n\n    for name_a, name_b in itertools.combinations(names, 2):\n        lat_a, lat_b = costs[name_a], costs[name_b]\n        probabilities_a = [0.0, 1.0]\n        if abs(lat_a - lat_b) > 1e-12:\n            p = (latency_budget - lat_b) / (lat_a - lat_b)\n            if 0.0 <= p <= 1.0:\n                probabilities_a.append(p)\n\n        for p in probabilities_a:\n            expected_latency = p * lat_a + (1 - p) * lat_b\n            if expected_latency <= latency_budget + EPS:\n                mixed_acc = p * acc[name_a] + (1 - p) * acc[name_b]\n                best = mixed_acc if best is None else max(best, mixed_acc)\n\n    return best\n\nrows = []\nroutes = [\"R->V\", \"M->V\", \"R->M->V\"]\n\nfor condition_name, eval_data in data.items():\n    # Do not duplicate the clean condition under both tuning-source labels.\n    sources = [(\"clean-tuned\", \"clean\")]\n    if condition_name != \"clean\":\n        sources.append((\"condition-tuned (diagnostic)\", condition_name))\n\n    for source_label, tuning_name in sources:\n        tuning_data = data[tuning_name]\n\n        for route in routes:\n            for budget in BUDGETS:\n                selected = choose_thresholds_fixed(route, tuning_data, budget)\n                if selected is None:\n                    continue\n\n                tune_acc, tune_cost, tr, tm = 