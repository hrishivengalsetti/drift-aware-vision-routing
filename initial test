nsors:\")\nfor name, pred in [\n    (\"ResNet-20\", resnet_preds),\n    (\"MobileNetV2 ×1.4\", mobile_preds),\n    (\"ViT-Base/16\", vit_preds),\n]:\n    pred = torch.as_tensor(pred).cpu().long()\n    correct = pred.eq(clean_y)\n    print(f\"{name}: {100 * correct.float().mean().item():.2f}% \"\n          f\"({correct.sum().item()}/10000)\")\n\nprint(\"\\nRecomputed clean overlap:\")\nr_ok = torch.as_tensor(resnet_preds).cpu().long().eq(clean_y)\nm_ok = torch.as_tensor(mobile_preds).cpu().long().eq(clean_y)\nv_ok = torch.as_tensor(vit_preds).cpu().long().eq(clean_y)\nprint(\"ResNet wrong, MobileNet right:\", int((~r_ok & m_ok).sum()))\nprint(\"ResNet wrong, ViT right:\", int((~r_ok & v_ok).sum()))\nprint(\"All three wrong:\", int((~r_ok & ~m_ok & ~v_ok).sum()))\n\nprint(\"\\nCorruption cache checks:\")\nfor name, d in corruption_results.items():\n    y = torch.as_tensor(d[\"labels\"]).cpu().long()\n    check(f\"{name}: 10,000 labels match clean order\",\n          len(y) == 10_000 and torch.equal(y, clean_y))\n    for model_name, logits_key, preds_key in [\n        (\"ResNet\", \"resnet_logits\", \"resnet_preds\"),\n        (\"MobileNet\", \"mobile_logits\", \"mobile_preds\"),\n        (\"ViT\", \"vit_logits\", \"vit_preds\"),\n    ]:\n        logits = torch.as_tensor(d[logits_key]).cpu()\n        preds = torch.as_tensor(d[preds_key]).cpu().long()\n        check(f\"{name}: {model_name} predictions match cached logits\",\n              len(logits) == len(preds) == 10_000 and\n              torch.equal(logits.argmax(1), preds))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-29T20:35:12.293551Z","iopub.execute_input":"2026-10-29T20:35:12.294587Z","iopub.status.idle":"2026-10-29T20:35:12.321134Z","shell.execute_reply.started":"2026-10-29T20:35:12.294554Z","shell.execute_reply":"2026-10-29T20:35:12.320097Z"}},"outputs":[{"name":"stdout","text":"OK: clean labels match CIFAR-10 test order\nOK: ViT labels match clean labels\nOK: all clean caches have 