>V\":\n            vit_rate = (\n                (d[\"rc\"][eval_idx] < best_2[\"tr\"])\n                .float().mean().item()\n            )\n        elif policy == \"R->M->V\":\n            vit_rate = (\n                (\n                    (d[\"rc\"][eval_idx] < best_3[\"tr\"]) &\n                    (d[\"mc\"][eval_idx] < best_3[\"tm\"])\n                ).float().mean().item()\n            )\n        else:\n            vit_rate = 1.0 if policy == \"V\" else 0.0\n\n        rows.append({\n            \"Condition\": name,\n            \"Policy\": policy,\n            \"Eval accuracy (%)\": round(\n                100 * pred_eval.eq(y_eval).float().mean().item(), 2\n            ),\n            \"Modelled latency (ms/image)\": round(latency_eval, 2),\n            \"ViT escalation (%)\": round(100 * vit_rate, 2),\n        })\n\nresults_df = pd.DataFrame(rows)\n\ndisplay(\n    results_df.pivot(\n        index=\"Condition\",\n        columns=\"Policy\",\n        values=\"Eval accuracy (%)\"\n    ).round(2)\n)\n\ndisplay(results_df.round(2))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-29T20:19:10.133898Z","iopub.execute_input":"2026-10-29T20:19:10.134245Z","iopub.status.idle":"2026-10-29T20:19:10.264659Z","shell.execute_reply.started":"2026-10-29T20:19:10.134219Z","shell.execute_reply":"2026-10-29T20:19:10.263976Z"}},"outputs":[{"name":"stdout","text":"Thresholds selected using clean tuning data:\nResNet -> ViT: {'tr': 0.9896947145462036, 'acc': 0.9625999927520752, 'ms': 5.819999694824219}\nResNet -> MobileNet -> ViT: {'tr': 0.9996957182884216, 'tm': 0.9977582693099976, 'acc': 0.9685999751091003, 'ms': 7.374399185180664}\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Policy                M      R  R->M->V   R->V      V\nCondition                                            \nclean             93.88  92.48    96.36  95.74  94.80\nfog               90.42  88.26    94.26  93.58  92.90\ngaussian_noise    24.14  