sults.\nfor condition_name, d in corruption_results.items():\n    confidence_inputs[condition_name] = {\n        \"y\": torch.as_tensor(d[\"labels\"]).cpu().long(),\n        \"logits\": {\n            \"ResNet-20\": torch.as_tensor(d[\"resnet_logits\"]).cpu(),\n            \"MobileNetV2 ×1.4\": torch.as_tensor(d[\"mobile_logits\"]).cpu(),\n            \"ViT-Base/16\": torch.as_tensor(d[\"vit_logits\"]).cpu(),\n        },\n    }\n\ndef expected_calibration_error(confidence, correct, bins=15):\n    edges = torch.linspace(0.0, 1.0, bins + 1)\n    ece = 0.0\n\n    for i in range(bins):\n        # Include the right endpoint in the final bin.\n        if i == bins - 1:\n            in_bin = (confidence >= edges[i]) & (confidence <= edges[i + 1])\n        else:\n            in_bin = (confidence >= edges[i]) & (confidence < edges[i + 1])\n\n        if in_bin.any():\n            bin_confidence = confidence[in_bin].mean().item()\n            bin_accuracy = correct[in_bin].float().mean().item()\n            ece += in_bin.float().mean().item() * abs(bin_confidence - bin_accuracy)\n\n    return ece\n\nrows = []\n\nfor condition_name, condition in confidence_inputs.items():\n    y = condition[\"y\"]\n\n    for model_name, logits in condition[\"logits\"].items():\n        logits = logits.float()\n        assert logits.ndim == 2 and logits.shape[0] == len(y), (\n            f\"{condition_name}/{model_name}: logits-label shape mismatch\"\n        )\n\n        probs = logits.softmax(dim=1)\n        top_values, top_indices = probs.topk(2, dim=1)\n        confidence = top_values[:, 0]\n        margin = top_values[:, 0] - top_values[:, 1]\n        entropy = -(probs * probs.clamp_min(1e-12).log()).sum(dim=1)\n        correct = top_indices[:, 0].eq(y)\n\n        target = correct.numpy().astype(\"int32\")\n        rows.append({\n            \"Condition\": condition_name,\n            \"Model\": model_name,\n            \"Accuracy (%)\": 100 * correct.float().mean().item(),\n            \"AUROC max-softmax\": roc_auc_score(target, confidence.numpy()),\n            \"AUROC margin\": roc_auc_score(target, margin.numpy()),\n            \"AUROC negative entropy\": roc_auc_score(target, (-entropy).numpy()),\n            \"Max-softmax ECE (15 bins)\": expected_calibration_error(\n                confidence, correct, bins=15\n            ),\n        })\n\nconfidence_df = pd.DataFrame(rows)\n\nprint(\"Confidence signal quality from cached logits\")\ndisplay(confidence_df.round(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-29T21:01:19.014155Z","iopub.execute_input":"2026-10-29T21:01:19.015069Z","iopub.status.idle":"2026-10-29T21:01:19.375893Z","shell.execute_reply.started":"2026-10-29T21:01:19.015034Z","shell.execute_reply":"2026-10-29T21:01:19.375146Z"}},"outputs":[{"name":"stdout","text":"Confidence signal quality from cached logits\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           Condition             Model  Accuracy (%)  AUROC max-softmax  \\\n0              clean         ResNet-20         92.60             0.9216   \n1              clean  MobileNetV2 ×1.4         94.21             0.9134   \n2     gaussian_noise         ResNet-20         30.17             0.6580   \n3     gaussian_noise  MobileNetV2 ×1.4         24.32             0.6628   \n4     gaussian_noise       ViT-Base/16         79.40             0.8171   \n5        motion_blur         ResNet-20         68.05             0.7855   \n6        motion_blur  MobileNetV2 ×1.4         70.98             0.7952   \n7        motion_blur       ViT-Base/16         86.98             0.8703   \n8                fog         ResNet-20         87.91             0.8946   \n9                fog  MobileNetV2 ×1.4         90.39             0.8930   \n10               fog       ViT-Base/16         93.04             0.8873   \n11  jpeg_compression         ResNet-20         74.89             0.8133   \n12  jpeg_compression  MobileNetV2 ×1.4         76.5