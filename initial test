": d[\"labels\"].cpu(),\n        \"R_logits\": d[\"resnet_logits\"].cpu(),\n        \"M_logits\": d[\"mobile_logits\"].cpu(),\n        \"V_pred\": d[\"vit_preds\"].cpu(),\n    }\n\ndef prepare(d):\n    r_logits, m_logits = d[\"R_logits\"], d[\"M_logits\"]\n    return {\n        \"y\": d[\"y\"],\n        \"r\": r_logits.argmax(1),\n        \"m\": m_logits.argmax(1),\n        \"v\": d[\"V_pred\"],\n        \"rc\": r_logits.softmax(1).max(1).values,\n        \"mc\": m_logits.softmax(1).max(1).values,\n    }\n\ndata = {name: prepare(d) for name, d in conditions.items()}\n\n# Same image-ID split for clean and all corruptions\ng = torch.Generator().manual_seed(2026)\nperm = torch.randperm(10_000, generator=g)\ntune_idx, eval_idx = perm[:5000], perm[5000:]\n\ndef predict_policy(d, policy, tr=None, tm=None):\n    r, m, v = d[\"r\"], d[\"m\"], d[\"v\"]\n\n    if policy == \"R\":\n        return r, LAT[\"R\"]\n    if policy == \"M\":\n        return m, LAT[\"M\"]\n    if policy == \"V\":\n        return v, LAT[\"V\"]\n\n    if policy == \"R->V\":\n        escalate = d[\"rc\"] < tr\n        pred = torch.where(escalate, v, r)\n        cost = LAT[\"R\"] + escalate.float() * LAT[\"V\"]\n        return pred, cost\n\n    if policy == \"R->M->V\":\n        to_m = d[\"rc\"] < tr\n        to_v = to_m & (d[\"mc\"] < tm)\n        pred = torch.where(to_v, v, torch.where(to_m, m, r))\n        cost = (\n            LAT[\"R\"]\n            + to_m.float() * LAT[\"M\"]\n            + to_v.float() * LAT[\"V\"]\n        )\n        return pred, cost\n\n    raise ValueError(f\"Unknown policy: {policy}\")\n\n# Candidate confidence thresholds from clean tuning data\nclean = data[\"clean\"]\nq = torch.linspace(0, 1, 11)\n\nr_thresholds = torch.quantile(\n    clean[\"rc\"][tune_idx], q\n).unique()\nm_thresholds = torch.quantile(\n    clean[\"mc\"][tune_idx], q\n).unique()\n\n# Select thresholds using clean tuning accuracy,\n# requiring modelled latency below always-ViT.\nbest_2 = None\n\nfor tr in r_